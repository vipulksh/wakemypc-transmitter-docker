# Copy to .env and fill in. `docker compose up -d` reads it automatically.

# Base server URL (no trailing /ws/... path -- the transmitter adds it).
#   Production: wss://wakemypc.com
#   Local dev:  ws://192.168.1.10:8000
SERVER_URL=wss://wakemypc.com

# The transmitter's unique_id, exactly as registered on the dashboard
# (Transmitters -> Add). Any stable string works for a software transmitter.
UNIQUE_ID=my-docker-transmitter

# The transmitter's device token. On the dashboard open the transmitter and
# use "Rotate token" to reveal it, then paste it here.
TOKEN=paste-the-device-token-here

# --- optional ---
# FIRMWARE_VERSION=docker-1.0.0
# HEARTBEAT_INTERVAL=30
# DEVICE_SCAN_INTERVAL=60
# INSECURE_SKIP_TLS_VERIFY=0
# LOG_LEVEL=INFO
